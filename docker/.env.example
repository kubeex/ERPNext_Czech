# Zkopírovat jako .env (nebo custom.env) do checkoutu frappe_docker a
# doplnit hodnoty. Ověřeno proti docs/02-setup/04-env-variables.md a
# docs/02-setup/02-build-setup.md v github.com/frappe/frappe_docker
# (branch main, staženo 2026-09-15) — před použitím v produkci zkontrolovat,
# že se od té doby nezměnily.

# --- Vlastní build image (images/layered) ------------------------------
CUSTOM_IMAGE=erpnext-cz
CUSTOM_TAG=16
PULL_POLICY=missing

# --- Databáze (root heslo pro MariaDB kontejner) ----------------------------
DB_PASSWORD=change-me-strong-password

# --- HTTPS / Let's Encrypt (Traefik, overrides/compose.https.yaml) ---------
LETSENCRYPT_EMAIL=admin@firma.cz
SITES_RULE=Host(`erp.firma.cz`)

# --- Gunicorn tuning (výchozí hodnoty, uprav podle zátěže) ------------------
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
